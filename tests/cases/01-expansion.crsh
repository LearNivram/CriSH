suite expansion

v=hello
check plain          "$v"                       hello
check braces         "${v}world"                helloworld
check default-unset  "${nope:-fallback}"        fallback
check default-set    "${v:-fallback}"           hello
check alt-set        "${v:+yes}"                yes
check alt-unset      "${nope:+yes}"             ""
check length         "${#v}"                    5
check upper-all      "${v^^}"                   HELLO
check upper-one      "${v^}"                    Hello
lower=HELLO
check lower-all      "${lower,,}"               hello
check lower-one      "${lower,}"                hELLO

p=/usr/local/lib/libfoo.so.1
check strip-short    "${p#*/}"                  "usr/local/lib/libfoo.so.1"
check strip-long     "${p##*/}"                 "libfoo.so.1"
check chop-short     "${p%.*}"                  "/usr/local/lib/libfoo.so"
check chop-long      "${p%%.*}"                 "/usr/local/lib/libfoo"
check replace-first  "${p/lib/LIB}"             "/usr/local/LIB/libfoo.so.1"
check replace-all    "${p//lib/LIB}"            "/usr/local/LIB/LIBfoo.so.1"
check replace-head   "${p/#\/usr/USR}"          "USR/local/lib/libfoo.so.1"
check replace-tail   "${p/%1/ONE}"              "/usr/local/lib/libfoo.so.ONE"

s=abcdef
check substr         "${s:1:3}"                 bcd
check substr-open    "${s:3}"                   def
check substr-neg     "${s: -2}"                 ef

check arith          "$((2 + 3 * 4))"           14
check arith-paren    "$(( (2 + 3) * 4 ))"       20
check arith-pow      "$((2 ** 10))"             1024
check arith-hex      "$((0x1f))"                31
check arith-base     "$((16#ff))"               255
check arith-ternary  "$((1 ? 10 : 20))"         10
check arith-bits     "$(( (5 | 2) & 6 ))"       6
n=5
check arith-var      "$(( n * n ))"             25
check arith-incr     "$(( n++ )):$n"            "5:6"

check brace-list     "$(echo {a,b,c})"          "a b c"
check brace-range    "$(echo {1..5})"           "1 2 3 4 5"
check brace-step     "$(echo {0..10..5})"       "0 5 10"
check brace-alpha    "$(echo {a..e})"           "a b c d e"
check brace-pad      "$(echo {08..11})"         "08 09 10 11"

check cmdsub         "$(echo nested)"           nested
check cmdsub-nested  "$(echo "$(echo deep)")"   deep
check backtick       "`echo old`"               old

check quote-empty    "$(printf '[%s]' "")"      "[]"
check quote-spaces   "$(printf '[%s]' "a  b")"  "[a  b]"
